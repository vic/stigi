---
// One feature: a neon glyph in a tile, a title and a short sentence.
import Glyph, { type GlyphName } from './Glyph.astro';

interface Props {
	icon: GlyphName;
	title: string;
}

const { icon, title } = Astro.props;
---

<article class="feature">
	<span class="tile"><Glyph name={icon} tone="neon" size="1.5rem" /></span>
	<h3>{title}</h3>
	<div class="body"><slot /></div>
</article>

<style>
	.feature {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem;
		border: 1px solid transparent;
		border-radius: 0.875rem;
		/* a hairline frame that lights up into the gradient on hover */
		background:
			linear-gradient(var(--sl-color-bg), var(--sl-color-bg)) padding-box,
			linear-gradient(
					135deg,
					color-mix(in srgb, var(--stigi-cyan) 35%, var(--sl-color-hairline)),
					var(--sl-color-hairline) 45%,
					color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-hairline))
				)
				border-box;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease,
			background 0.25s ease;
	}

	.feature:hover {
		transform: translateY(-2px);
		background:
			linear-gradient(
					160deg,
					color-mix(in srgb, var(--sl-color-accent) 7%, var(--sl-color-bg)),
					var(--sl-color-bg) 60%
				)
				padding-box,
			linear-gradient(135deg, var(--stigi-cyan), var(--sl-color-accent)) border-box;
		box-shadow: 0 12px 32px -16px color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
	}

	.tile {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.75rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
		background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
	}

	h3 {
		margin: 0;
		font-family: var(--font-victor-mono);
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}

	.body,
	.body :global(p) {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--sl-color-gray-2);
	}

	@media (prefers-reduced-motion: reduce) {
		.feature,
		.feature:hover {
			transition: none;
			transform: none;
		}
	}
</style>
