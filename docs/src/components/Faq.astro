---
// Frequently asked questions: one open at a time, like the sidebar.
import Glyph from './Glyph.astro';

const items = [
	{ q: 'Do I have to rewrite everything in Stigi?', a: 'No. Export any Stigi module as a C library with a generated header and call it from Python, Rust, Go or C++. Start with one small, hot, risky piece.', href: '/platforms/c-interop/' },
	{ q: 'Does Stigi have a garbage collector?', a: 'No. Every object has one owner, inferred by the door, and is freed at its last use. You never write free and never write lifetimes.', href: '/language/memory/' },
	{ q: 'Why does it look like Scala 3?', a: 'Plain, readable syntax is what both people and language models read best. Stigi compresses what the door sends, never what you write.', href: '/agents/tokens/' },
	{ q: 'Why Datalog and not an SMT solver?', a: 'Stratified Datalog always finishes, always gives the same answer and runs in polynomial time. There is no solver that times out.', href: '/door/datalog/' },
	{ q: 'Is it safe to run AI-written tests?', a: 'Yes. Tests run inside a pure compile-time evaluator with no files, network, clock or system calls. They cannot touch your machine.', href: '/humans/testing/' },
	{ q: 'Can Stigi reject a correct program?', a: 'Yes, some. Its logic is decidable on purpose, so a few safe programs need a different shape. In return, checks are fast and predictable.', href: '/trust/limits/' },
	{ q: 'Why is Stigi AGPL?', a: 'So the tools that verify AI-written software stay free and auditable for everyone, and never belong to one closed vendor.', href: '/community/sponsor/' },
];
---

<div class="faq not-content">
	{
		items.map(({ q, a, href }) => (
			<details name="faq">
				<summary>
					<span>{q}</span>
					<Glyph name="chevron" class="caret" size="1.1rem" />
				</summary>
				<p>
					{a} <a href={href}>Read more</a>
				</p>
			</details>
		))
	}
</div>

<style>
	.faq {
		margin-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
		interpolate-size: allow-keywords;
	}

	details {
		border-bottom: 1px solid var(--sl-color-hairline);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.1rem 0.5rem;
		cursor: pointer;
		list-style: none;
		font-family: var(--font-victor-mono);
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary:hover {
		color: var(--sl-color-accent-high);
	}

	summary:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}

	summary :global(.caret) {
		color: var(--sl-color-gray-3);
		transition: transform 0.2s ease;
	}

	details[open] summary :global(.caret) {
		transform: rotate(90deg);
		color: var(--sl-color-accent);
	}

	details::details-content {
		block-size: 0;
		overflow-y: clip;
		transition:
			block-size 0.3s ease,
			content-visibility 0.3s allow-discrete;
	}

	details[open]::details-content {
		block-size: auto;
	}

	p {
		margin: 0;
		padding: 0 0.5rem 1.25rem;
		max-width: 62ch;
		font-size: 0.9rem;
		line-height: 1.75;
		color: var(--sl-color-gray-2);
	}

	p a {
		color: var(--stigi-cyan);
	}

	@media (prefers-reduced-motion: reduce) {
		summary :global(.caret),
		details::details-content {
			transition: none;
		}
	}
</style>
