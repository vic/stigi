// prompt: map an L0 binary operator token kind to its precedence level (zero if not binary).
def Stigi.Parse.binPrecedence(kind: Stigi.Lex.TokenKind): U64 <lessOrEqual(result, 6)> =
  case TokPipe => 1
  case TokLogicOr => 2
  case TokLogicAnd => 3
  case TokEqual => 4
  case TokNotEqual => 4
  case TokLess => 4
  case TokLessEqual => 4
  case TokGreat => 4
  case TokGreatEqual => 4
  case TokPlus => 5
  case TokMinus => 5
  case TokStar => 6
  case TokSlash => 6
  case TokPercent => 6
  case TokDef => 0
  case TokVal => 0
  case TokVar => 0
  case TokEnum => 0
  case TokCase => 0
  case TokMatch => 0
  case TokIf => 0
  case TokThen => 0
  case TokElse => 0
  case TokWhile => 0
  case TokLoopBody => 0
  case TokType => 0
  case TokTrait => 0
  case TokGiven => 0
  case TokCapability => 0
  case TokHandler => 0
  case TokHandle => 0
  case TokExtern => 0
  case TokRelation => 0
  case TokRule => 0
  case TokLemma => 0
  case TokPub => 0
  case TokFor => 0
  case TokState => 0
  case TokStart => 0
  case TokStop => 0
  case TokTrue => 0
  case TokFalse => 0
  case TokIdent => 0
  case TokUpper => 0
  case TokInt => 0
  case TokStr => 0
  case TokChar => 0
  case TokArrow => 0
  case TokColonAssign => 0
  case TokAssign => 0
  case TokColon => 0
  case TokComma => 0
  case TokDot => 0
  case TokLeftParen => 0
  case TokRightParen => 0
  case TokLeftBrack => 0
  case TokRightBrack => 0
  case TokLeftBrace => 0
  case TokRightBrace => 0
  case TokAt => 0
  case TokBang => 0
  case TokNewline => 0
