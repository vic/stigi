// prompt: the own index that a syntax node holds.
def Stigi.Syntax.atOf(node: Stigi.Syntax.Node): U64 =
  node match
    case Absent(at) => at
    case Name(at, _) => at
    case TypeRef(at, _, _, _, _) => at
    case FactAtom(at, _, _, _, _) => at
    case FactCompare(at, _, _, _, _, _) => at
    case FactArith(at, _, _, _, _, _, _) => at
    case FactDeny(at, _) => at
    case FactGroup(at, _) => at
    case Param(at, _, _) => at
    case CapParam(at, _, _) => at
    case CapGroup(at, _) => at
    case PatName(at, _) => at
    case PatLiteral(at, _) => at
    case PatCtor(at, _, _) => at
    case PatTuple(at, _) => at
    case PatOr(at, _) => at
    case PatRange(at, _, _) => at
    case Literal(at, _, _) => at
    case Ref(at, _) => at
    case Call(at, _, _, _, _, _) => at
    case Binary(at, _, _, _) => at
    case Unary(at, _, _) => at
    case IsTest(at, _, _) => at
    case IfElse(at, _, _, _) => at
    case WhileLoop(at, _, _) => at
    case MatchOn(at, _, _) => at
    case Arm(at, _, _, _) => at
    case ValStmt(at, _, _, _, _) => at
    case VarStmt(at, _, _, _, _) => at
    case AssignStmt(at, _, _) => at
    case IndexRead(at, _, _) => at
    case IndexWrite(at, _, _, _) => at
    case HandleStmt(at, _, _, _, _, _, _, _) => at
    case AssertStmt(at, _, _) => at
    case DenyStmt(at, _) => at
    case Block(at, _) => at
    case LocalDecl(at, _) => at
    case DefHead(at, _, _, _, _, _, _, _) => at
    case FunctionDecl(at, _, _, _, _, _, _) => at
    case ValDecl(at, _, _, _, _, _) => at
    case EnumDecl(at, _, _, _, _) => at
    case EnumCase(at, _, _, _, _) => at
    case TypeDecl(at, _, _, _, _, _, _, _) => at
    case CapabilityDecl(at, _, _, _, _, _, _, _) => at
    case HandlerDecl(at, _, _, _, _, _, _, _, _, _) => at
    case TraitDecl(at, _, _, _, _) => at
    case GivenDecl(at, _, _, _, _, _, _) => at
    case ExternDef(at, _, _, _, _, _) => at
    case ExternVal(at, _, _, _, _) => at
    case RelationDecl(at, _, _, _) => at
    case RuleDecl(at, _, _, _, _, _) => at
    case UnitRoot(at, _, _) => at
