// prompt: write the C11 cast or infix operator token for built-in U64/U32/U8/I64/I32 primitive calls.
def Stigi.Emit.emitPrimParts {writer: Stigi.Emit.Writer, Stigi.Mut} (outCap: Stigi.EmitCap, outBuf: Array[U8](outCap), callee: Stigi.Emit.CalleeKind, phase: U64) <below(0, outCap), lessOrEqual(phase, 2)>: Unit =
  if phase == 0 then
    callee match
      case CalleeCastWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint64_t)(")
      case CalleeCastWordShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint32_t)(")
      case CalleeCastByte => Stigi.Emit.writeLit{writer}(outCap, outBuf, 11, "((uint8_t)(")
      case CalleeCastSignedLong => Stigi.Emit.writeLit{writer}(outCap, outBuf, 11, "((int64_t)(")
      case CalleeCastSignedWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 11, "((int32_t)(")
      case CalleeWrapAddWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint64_t)(")
      case CalleeWrapSubWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint64_t)(")
      case CalleeWrapMulWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint64_t)(")
      case CalleeBitAndWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint64_t)(")
      case CalleeBitOrWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint64_t)(")
      case CalleeBitXorWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint64_t)(")
      case CalleeShiftLeftWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint64_t)(")
      case CalleeShiftRightWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint64_t)(")
      case CalleeWrapAddShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint32_t)(")
      case CalleeWrapSubShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint32_t)(")
      case CalleeWrapMulShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint32_t)(")
      case CalleeBitAndShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint32_t)(")
      case CalleeBitOrShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint32_t)(")
      case CalleeBitXorShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint32_t)(")
      case CalleeShiftLeftShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint32_t)(")
      case CalleeShiftRightShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 12, "((uint32_t)(")
      case CalleeMixWord => ()
      case CalleeRotateRightShort => ()
      case CalleeTraitEqual => ()
      case CalleeTraitLess => ()
      case CalleeAbiOpenat => ()
      case CalleeAbiUnlink => ()
      case CalleeAbiClock => ()
      case CalleeAbiUsage => ()
      case CalleeAbiDirect => ()
      case CalleeNormal => ()
  else if phase == 1 then
    callee match
      case CalleeWrapAddWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") + (uint64_t)(")
      case CalleeWrapSubWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") - (uint64_t)(")
      case CalleeWrapMulWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") * (uint64_t)(")
      case CalleeBitAndWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") & (uint64_t)(")
      case CalleeBitOrWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") | (uint64_t)(")
      case CalleeBitXorWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") ^ (uint64_t)(")
      case CalleeShiftLeftWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 17, ") << ((uint64_t)(")
      case CalleeShiftRightWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 17, ") >> ((uint64_t)(")
      case CalleeWrapAddShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") + (uint32_t)(")
      case CalleeWrapSubShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") - (uint32_t)(")
      case CalleeWrapMulShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") * (uint32_t)(")
      case CalleeBitAndShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") & (uint32_t)(")
      case CalleeBitOrShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") | (uint32_t)(")
      case CalleeBitXorShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 15, ") ^ (uint32_t)(")
      case CalleeShiftLeftShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 17, ") << ((uint32_t)(")
      case CalleeShiftRightShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 17, ") >> ((uint32_t)(")
      case CalleeCastWord => ()
      case CalleeCastWordShort => ()
      case CalleeCastByte => ()
      case CalleeCastSignedLong => ()
      case CalleeCastSignedWord => ()
      case CalleeMixWord => ()
      case CalleeRotateRightShort => ()
      case CalleeTraitEqual => ()
      case CalleeTraitLess => ()
      case CalleeAbiOpenat => ()
      case CalleeAbiUnlink => ()
      case CalleeAbiClock => ()
      case CalleeAbiUsage => ()
      case CalleeAbiDirect => ()
      case CalleeNormal => ()
  else
    callee match
      case CalleeShiftLeftWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 9, ") & 63U))")
      case CalleeShiftRightWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 9, ") & 63U))")
      case CalleeShiftLeftShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 9, ") & 31U))")
      case CalleeShiftRightShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 9, ") & 31U))")
      case CalleeCastWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeCastWordShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeCastByte => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeCastSignedLong => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeCastSignedWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeWrapAddWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeWrapSubWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeWrapMulWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeBitAndWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeBitOrWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeBitXorWord => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeWrapAddShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeWrapSubShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeWrapMulShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeBitAndShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeBitOrShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeBitXorShort => Stigi.Emit.writeLit{writer}(outCap, outBuf, 2, "))")
      case CalleeMixWord => ()
      case CalleeRotateRightShort => ()
      case CalleeTraitEqual => ()
      case CalleeTraitLess => ()
      case CalleeAbiOpenat => ()
      case CalleeAbiUnlink => ()
      case CalleeAbiClock => ()
      case CalleeAbiUsage => ()
      case CalleeAbiDirect => ()
      case CalleeNormal => ()
