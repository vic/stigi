// prompt: write the C11 infix operator bytes corresponding to one binary L0 token kind.
def Stigi.Emit.emitOperTok {writer: Stigi.Emit.Writer, Stigi.Mut} (outCap: Stigi.EmitCap, outBuf: Array[U8](outCap), operKind: Stigi.Lex.TokenKind) <below(0, outCap)>: Unit =
  operKind match
    case TokLogicOr => Stigi.Emit.writeLit{writer}(outCap, outBuf, 4, " || ")
    case TokLogicAnd => Stigi.Emit.writeLit{writer}(outCap, outBuf, 4, " && ")
    case TokEqual => Stigi.Emit.writeLit{writer}(outCap, outBuf, 4, " == ")
    case TokNotEqual => Stigi.Emit.writeLit{writer}(outCap, outBuf, 4, " != ")
    case TokLess => Stigi.Emit.writeLit{writer}(outCap, outBuf, 3, " < ")
    case TokLessEqual => Stigi.Emit.writeLit{writer}(outCap, outBuf, 4, " <= ")
    case TokGreat => Stigi.Emit.writeLit{writer}(outCap, outBuf, 3, " > ")
    case TokGreatEqual => Stigi.Emit.writeLit{writer}(outCap, outBuf, 4, " >= ")
    case TokPlus => Stigi.Emit.writeLit{writer}(outCap, outBuf, 3, " + ")
    case TokMinus => Stigi.Emit.writeLit{writer}(outCap, outBuf, 3, " - ")
    case TokStar => Stigi.Emit.writeLit{writer}(outCap, outBuf, 3, " * ")
    case TokSlash => Stigi.Emit.writeLit{writer}(outCap, outBuf, 3, " / ")
    case TokPercent => Stigi.Emit.writeLit{writer}(outCap, outBuf, 3, " % ")
    case TokDef => ()
    case TokVal => ()
    case TokVar => ()
    case TokEnum => ()
    case TokCase => ()
    case TokMatch => ()
    case TokIf => ()
    case TokThen => ()
    case TokElse => ()
    case TokWhile => ()
    case TokLoopBody => ()
    case TokType => ()
    case TokTrait => ()
    case TokGiven => ()
    case TokCapability => ()
    case TokHandler => ()
    case TokHandle => ()
    case TokExtern => ()
    case TokRelation => ()
    case TokRule => ()
    case TokLemma => ()
    case TokPub => ()
    case TokFor => ()
    case TokState => ()
    case TokStart => ()
    case TokStop => ()
    case TokTrue => ()
    case TokFalse => ()
    case TokIs => ()
    case TokIdent => ()
    case TokUpper => ()
    case TokInt => ()
    case TokStr => ()
    case TokChar => ()
    case TokPipe => ()
    case TokArrow => ()
    case TokColonAssign => ()
    case TokBar => ()
    case TokAssign => ()
    case TokColon => ()
    case TokComma => ()
    case TokDot => ()
    case TokDotDot => ()
    case TokLeftParen => ()
    case TokRightParen => ()
    case TokLeftBrack => ()
    case TokRightBrack => ()
    case TokLeftBrace => ()
    case TokRightBrace => ()
    case TokAt => ()
    case TokBang => ()
    case TokNewline => ()
    case TokEnd => ()
