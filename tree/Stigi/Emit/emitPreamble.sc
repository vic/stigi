// prompt: emit the ISO C11 POSIX runtime preamble with cache-aligned allocator and guard-paged stack.
def Stigi.Emit.emitPreamble {writer: Stigi.Emit.Writer, Stigi.Mut} (outCap: Stigi.EmitCap, outBuf: Array[U8](outCap)) <below(0, outCap)>: Unit =
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 19, "#define _GNU_SOURCE")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 19, "#include <stdint.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 20, "#include <stdbool.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 19, "#include <stddef.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 19, "#include <signal.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 21, "#include <sys/mman.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 19, "#include <unistd.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 18, "#include <fcntl.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 25, "#include <sys/resource.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 17, "#include <time.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 19, "#include <stdlib.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 19, "#include <string.h>")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 65, "typedef enum { STIGI_RT_OK = 0, STIGI_RT_ERR = 1 } StigiRtStatus;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 69, "typedef struct { void *stack_raw; size_t stack_total; } StigiRtState;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 69, "static inline void *stigi_rt_try_alloc(uint64_t count, size_t elem) {")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 30, "  if (elem == 0U) return NULL;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 38, "  if (count == 0U) return calloc(1,1);")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 53, "  if (count > ((uint64_t)SIZE_MAX)/elem) return NULL;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 36, "  size_t total = (size_t)count*elem;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 21, "#if defined(__FILC__)")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 36, "  return calloc((size_t)count,elem);")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 5, "#else")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 21, "  if (total >= 64U) {")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 19, "    void *p = NULL;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 57, "    if (posix_memalign(&p, 64U, total) != 0) return NULL;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 24, "    memset(p, 0, total);")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 13, "    return p;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 3, "  }")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 36, "  return calloc((size_t)count,elem);")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 6, "#endif")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 1, "}")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 48, "static void stigi_rt_shutdown(StigiRtState *s) {")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 57, "  if (s->stack_raw) munmap(s->stack_raw, s->stack_total);")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 1, "}")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 53, "static StigiRtStatus stigi_rt_init(StigiRtState *s) {")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 42, "  s->stack_raw = NULL; s->stack_total = 0;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 69, "  long ps = sysconf(_SC_PAGESIZE); size_t pg = ps>0?(size_t)ps:4096U;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 37, "  size_t tot = pg + (size_t)4194304U;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 79, "  void *r = mmap(NULL,tot,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 43, "  if (r == MAP_FAILED) return STIGI_RT_ERR;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 70, "  if (mprotect(r,pg,PROT_NONE)!=0){munmap(r,tot);return STIGI_RT_ERR;}")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 41, "  s->stack_raw = r; s->stack_total = tot;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 32, "#if defined(MADV_POPULATE_WRITE)")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 58, "  (void)madvise((char*)r+pg,4194304U,MADV_POPULATE_WRITE);")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 6, "#endif")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 60, "  struct sigaction sa; sa.sa_handler=SIG_IGN; sa.sa_flags=0;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 62, "  sigemptyset(&sa.sa_mask); (void)sigaction(SIGPIPE,&sa,NULL);")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 21, "  return STIGI_RT_OK;")
  Stigi.Emit.writeLine{writer}(outCap, outBuf, 1, "}")
