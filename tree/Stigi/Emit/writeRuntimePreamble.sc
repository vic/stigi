// prompt: emit portable ISO C headers, bit-mixing primitives, aligned allocator, Spectre mask, and S118 runtime init.
pub def Stigi.Emit.writeRuntimePreamble {Stigi.Mut} (outCap: U64, output: Array[U8](outCap), writeOffset: U64) <lessOrEqual(writeOffset, outCap), below(outCap, 0x100000000)>: U64 <lessOrEqual(writeOffset, result), lessOrEqual(result, outCap)> =
  var pos: U64 = Stigi.Emit.writeLine(19, "#define _GNU_SOURCE", outCap, output, writeOffset)
  pos = Stigi.Emit.writeLine(19, "#include <stdint.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(20, "#include <stdbool.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(19, "#include <stddef.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(19, "#include <signal.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(21, "#include <sys/mman.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(19, "#include <unistd.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(18, "#include <fcntl.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(25, "#include <sys/resource.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(17, "#include <time.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(19, "#include <stdlib.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(19, "#include <string.h>", outCap, output, pos)
  pos = Stigi.Emit.writeLine(52, "typedef struct { void *sraw; size_t stot; } StigiRt;", outCap, output, pos)
  pos = Stigi.Emit.writeSpectreMaskHelper(outCap, output, pos)
  pos = Stigi.Emit.writeLine(50, "static inline uint64_t stigi_u64_mix(uint64_t x) {", outCap, output, pos)
  pos = Stigi.Emit.writeLine(36, "  x += UINT64_C(0x9e3779b97f4a7c15);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(53, "  x = (x ^ (x >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(53, "  x = (x ^ (x >> 27)) * UINT64_C(0x94d049bb133111eb);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(23, "  return x ^ (x >> 31);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(1, "}", outCap, output, pos)
  pos = Stigi.Emit.writeLine(63, "static inline uint32_t stigi_u32_rotr(uint32_t x, uint32_t n) {", outCap, output, pos)
  pos = Stigi.Emit.writeLine(23, "  uint32_t s = n & 31U;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(53, "  return s == 0U ? x : ((x >> s) | (x << (32U - s)));", outCap, output, pos)
  pos = Stigi.Emit.writeLine(1, "}", outCap, output, pos)
  pos = Stigi.Emit.writeLine(68, "static inline void *stigi_rt_try_alloc(uint64_t count, size_t esz) {", outCap, output, pos)
  pos = Stigi.Emit.writeLine(29, "  if (esz == 0U) return NULL;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(41, "  if (count == 0U) return calloc(1U, 1U);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(54, "  if (count > ((uint64_t)SIZE_MAX) / esz) return NULL;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(37, "  size_t total = (size_t)count * esz;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(21, "  if (total >= 64U) {", outCap, output, pos)
  pos = Stigi.Emit.writeLine(21, "    void *ptr = NULL;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(74, "    if (posix_memalign(&ptr, 64U, total) != 0 || ptr == NULL) return NULL;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(26, "    memset(ptr, 0, total);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(15, "    return ptr;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(3, "  }", outCap, output, pos)
  pos = Stigi.Emit.writeLine(36, "  return calloc((size_t)count, esz);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(1, "}", outCap, output, pos)
  pos = Stigi.Emit.writeLine(44, "static void stigi_rt_shutdown(StigiRt *st) {", outCap, output, pos)
  pos = Stigi.Emit.writeLine(78, "  if (st->sraw != NULL) { (void)munmap(st->sraw, st->stot); st->sraw = NULL; }", outCap, output, pos)
  pos = Stigi.Emit.writeLine(1, "}", outCap, output, pos)
  pos = Stigi.Emit.writeLine(39, "static int stigi_rt_init(StigiRt *st) {", outCap, output, pos)
  pos = Stigi.Emit.writeLine(33, "  st->sraw = NULL; st->stot = 0U;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(34, "  long ps = sysconf(_SC_PAGESIZE);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(44, "  size_t page = ps > 0 ? (size_t)ps : 4096U;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(31, "  size_t tot = page + 1048576U;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(90, "  void *raw = mmap(NULL, tot, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(34, "  if (raw == MAP_FAILED) return 1;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(80, "  if (mprotect(raw, page, PROT_NONE) != 0) { (void)munmap(raw, tot); return 1; }", outCap, output, pos)
  pos = Stigi.Emit.writeLine(33, "  st->sraw = raw; st->stot = tot;", outCap, output, pos)
  pos = Stigi.Emit.writeLine(32, "#if defined(MADV_POPULATE_WRITE)", outCap, output, pos)
  pos = Stigi.Emit.writeLine(107, "  if (madvise((char *)raw + page, 1048576U, MADV_POPULATE_WRITE) != 0) { stigi_rt_shutdown(st); return 2; }", outCap, output, pos)
  pos = Stigi.Emit.writeLine(6, "#endif", outCap, output, pos)
  pos = Stigi.Emit.writeLine(90, "  struct sigaction sa; sa.sa_handler = SIG_IGN; sa.sa_flags = 0; sigemptyset(&sa.sa_mask);", outCap, output, pos)
  pos = Stigi.Emit.writeLine(78, "  if (sigaction(SIGPIPE, &sa, NULL) != 0) { stigi_rt_shutdown(st); return 4; }", outCap, output, pos)
  pos = Stigi.Emit.writeLine(11, "  return 0;", outCap, output, pos)
  Stigi.Emit.writeLine(1, "}", outCap, output, pos)
