// prompt: classify a qualified callee name into built-in arithmetic, trait, POSIX ABI, or normal user callee.
def Stigi.Emit.classifyCallee(srcCap: Stigi.ByteCap, src: Array[U8](srcCap), beg: U64, fin: U64) <lessOrEqual(beg, fin), lessOrEqual(fin, srcCap)>: Stigi.Emit.CalleeKind =
  if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 8, "U64.ofU8") || Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 9, "U64.ofU32") || Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 9, "U64.ofI64") || Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 9, "U64.ofI32") then CalleeCastWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 9, "U32.ofU64") || Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 8, "U32.ofU8") then CalleeCastWordShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 8, "U8.ofU64") || Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 8, "U8.ofU32") then CalleeCastByte else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 9, "I64.ofU64") then CalleeCastSignedLong else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 9, "I32.ofU64") || Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 9, "I32.ofI64") then CalleeCastSignedWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 15, "U64.wrappingAdd") then CalleeWrapAddWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 20, "U64.wrappingSubtract") then CalleeWrapSubWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 20, "U64.wrappingMultiply") then CalleeWrapMulWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 14, "U64.bitwiseAnd") then CalleeBitAndWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 13, "U64.bitwiseOr") then CalleeBitOrWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 14, "U64.bitwiseXor") then CalleeBitXorWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 13, "U64.shiftLeft") then CalleeShiftLeftWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 14, "U64.shiftRight") then CalleeShiftRightWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 15, "U32.wrappingAdd") then CalleeWrapAddShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 20, "U32.wrappingSubtract") then CalleeWrapSubShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 20, "U32.wrappingMultiply") then CalleeWrapMulShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 14, "U32.bitwiseAnd") then CalleeBitAndShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 13, "U32.bitwiseOr") then CalleeBitOrShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 14, "U32.bitwiseXor") then CalleeBitXorShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 13, "U32.shiftLeft") then CalleeShiftLeftShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 14, "U32.shiftRight") then CalleeShiftRightShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 7, "U64.mix") then CalleeMixWord else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 15, "U32.rotateRight") then CalleeRotateRightShort else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 17, "Stigi.Equal.equal") then CalleeTraitEqual else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 20, "Stigi.Order.lessThan") then CalleeTraitLess else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 6, "openat") then CalleeAbiOpenat else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 6, "unlink") then CalleeAbiUnlink else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 13, "clock_gettime") then CalleeAbiClock else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 9, "getrusage") then CalleeAbiUsage else if Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 4, "read") || Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 5, "write") || Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 5, "lseek") || Stigi.Lex.sliceEquals(srcCap, src, beg, fin, 5, "close") then CalleeAbiDirect else CalleeNormal
