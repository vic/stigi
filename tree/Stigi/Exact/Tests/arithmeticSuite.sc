// prompt: verify exact 128-bit signed arithmetic edge cases, overflows, and truncation toward zero.
val Stigi.Exact.Tests.arithmeticSuite {Stigi.Test}: Stigi.Test.Result =
  val zeroVal: Stigi.Exact.IntWide = Stigi.Exact.fromSigned(0)
  val oneVal: Stigi.Exact.IntWide = Stigi.Exact.fromSigned(1)
  val negOneVal: Stigi.Exact.IntWide = Stigi.Exact.fromSigned(-1)
  val maxUnsigned: Stigi.Exact.IntWide = Stigi.Exact.fromUnsigned(18446744073709551615)
  val maxSigned: Stigi.Exact.IntWide = Stigi.Exact.fromSigned(9223372036854775807)
  val minSignedRaw: I64 = I64.ofU64(9223372036854775808)
  val minSigned: Stigi.Exact.IntWide = Stigi.Exact.fromSigned(minSignedRaw)
  val maxWide: Stigi.Exact.IntWide = WideInt(18446744073709551615, 9223372036854775807)
  val minWide: Stigi.Exact.IntWide = WideInt(0, minSignedRaw)
  val chkZero: Bool = Stigi.Exact.Tests.sameWide(zeroVal, Stigi.Exact.fromUnsigned(0))
  val chkOne: Bool = Stigi.Exact.Tests.sameWide(oneVal, Stigi.Exact.fromUnsigned(1))
  val chkNegOne: Bool = Stigi.Exact.Tests.sameWide(negOneVal, WideInt(18446744073709551615, -1))
  val chkMaxUnsigned: Bool = Stigi.Exact.Tests.sameWide(maxUnsigned, WideInt(18446744073709551615, 0))
  val chkMaxSigned: Bool = Stigi.Exact.Tests.sameWide(maxSigned, WideInt(9223372036854775807, 0))
  val chkMinSigned: Bool = Stigi.Exact.Tests.sameWide(minSigned, WideInt(9223372036854775808, -1))
  val chkOrdEqual: Bool = Stigi.Exact.compare(zeroVal, Stigi.Exact.fromUnsigned(0)) match
    case EqualTo => true
    case LessThan => false
    case GreaterThan => false
  val chkOrdLess: Bool = Stigi.Exact.compare(minSigned, maxSigned) match
    case LessThan => true
    case EqualTo => false
    case GreaterThan => false
  val chkOrdGreater: Bool = Stigi.Exact.compare(maxUnsigned, maxSigned) match
    case GreaterThan => true
    case LessThan => false
    case EqualTo => false
  val chkAddCarry: Bool = Stigi.Exact.add(maxUnsigned, oneVal) match
    case ExactValue(actual) => Stigi.Exact.Tests.sameWide(actual, WideInt(0, 1))
    case ExactOverflow => false
    case ExactDivideByZero => false
  val chkSubBorrow: Bool = Stigi.Exact.subtract(minSigned, oneVal) match
    case ExactValue(actual) => Stigi.Exact.Tests.sameWide(actual, WideInt(9223372036854775807, -1))
    case ExactOverflow => false
    case ExactDivideByZero => false
  val chkNegMin: Bool = Stigi.Exact.Tests.isExactOverflow(Stigi.Exact.negate(minWide))
  val chkNegPos: Bool = Stigi.Exact.negate(Stigi.Exact.fromSigned(42)) match
    case ExactValue(actual) => Stigi.Exact.Tests.sameWide(actual, Stigi.Exact.fromSigned(-42))
    case ExactOverflow => false
    case ExactDivideByZero => false
  val chkMulMinNegOne: Bool = Stigi.Exact.multiply(minSigned, negOneVal) match
    case ExactValue(actual) => Stigi.Exact.Tests.sameWide(actual, WideInt(9223372036854775808, 0))
    case ExactOverflow => false
    case ExactDivideByZero => false
  val chkMulMaxUnsigned: Bool = Stigi.Exact.Tests.isExactOverflow(Stigi.Exact.multiply(maxUnsigned, maxUnsigned))
  val chkMulMaxSigned: Bool = Stigi.Exact.multiply(maxSigned, maxSigned) match
    case ExactValue(actual) => Stigi.Exact.Tests.sameWide(actual, WideInt(1, 4611686018427387903))
    case ExactOverflow => false
    case ExactDivideByZero => false
  val chkAddOver: Bool = Stigi.Exact.Tests.isExactOverflow(Stigi.Exact.add(maxWide, oneVal))
  val chkSubOver: Bool = Stigi.Exact.Tests.isExactOverflow(Stigi.Exact.subtract(minWide, oneVal))
  val chkDivOver: Bool = Stigi.Exact.quotientRemainder(minWide, negOneVal) match
    case DivModOverflow => true
    case DivModValue(_, _) => false
    case DivModDivideByZero => false
  val chkDivZero: Bool = Stigi.Exact.quotientRemainder(oneVal, zeroVal) match
    case DivModDivideByZero => true
    case DivModValue(_, _) => false
    case DivModOverflow => false
  val chkDivNegPos: Bool = Stigi.Exact.quotientRemainder(Stigi.Exact.fromSigned(-7), Stigi.Exact.fromSigned(2)) match
    case DivModValue(quot, rem) => Stigi.Exact.Tests.sameWide(quot, Stigi.Exact.fromSigned(-3)) && Stigi.Exact.Tests.sameWide(rem, Stigi.Exact.fromSigned(-1))
    case DivModOverflow => false
    case DivModDivideByZero => false
  val chkDivPosNeg: Bool = Stigi.Exact.quotientRemainder(Stigi.Exact.fromSigned(7), Stigi.Exact.fromSigned(-2)) match
    case DivModValue(quot, rem) => Stigi.Exact.Tests.sameWide(quot, Stigi.Exact.fromSigned(-3)) && Stigi.Exact.Tests.sameWide(rem, Stigi.Exact.fromSigned(1))
    case DivModOverflow => false
    case DivModDivideByZero => false
  val chkDivNegNeg: Bool = Stigi.Exact.quotientRemainder(Stigi.Exact.fromSigned(-7), Stigi.Exact.fromSigned(-2)) match
    case DivModValue(quot, rem) => Stigi.Exact.Tests.sameWide(quot, Stigi.Exact.fromSigned(3)) && Stigi.Exact.Tests.sameWide(rem, Stigi.Exact.fromSigned(-1))
    case DivModOverflow => false
    case DivModDivideByZero => false
  val chkDivWide: Bool = Stigi.Exact.quotientRemainder(WideInt(0, 1), Stigi.Exact.fromSigned(2)) match
    case DivModValue(quot, rem) => Stigi.Exact.Tests.sameWide(quot, WideInt(9223372036854775808, 0)) && Stigi.Exact.Tests.sameWide(rem, zeroVal)
    case DivModOverflow => false
    case DivModDivideByZero => false
  val partOne: Bool = chkZero && chkOne && chkNegOne && chkMaxUnsigned && chkMaxSigned && chkMinSigned && chkOrdEqual && chkOrdLess && chkOrdGreater
  val partTwo: Bool = chkAddCarry && chkSubBorrow && chkNegMin && chkNegPos && chkMulMinNegOne && chkMulMaxUnsigned && chkMulMaxSigned
  val partThree: Bool = chkAddOver && chkSubOver && chkDivOver && chkDivZero && chkDivNegPos && chkDivPosNeg && chkDivNegNeg && chkDivWide
  val allPass: Bool = partOne && partTwo && partThree
  Stigi.Test.expect(allPass, true, "Stigi.Exact arithmetic suite must pass all exact 128-bit cases")
