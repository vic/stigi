// prompt: classify a single-byte punctuation symbol into its token kind.
def Stigi.Lex.singlePunct(byte: U8): Stigi.Lex.Punct =
  case '(' => Punct(TokLeftParen)
  case ')' => Punct(TokRightParen)
  case '[' => Punct(TokLeftBrack)
  case ']' => Punct(TokRightBrack)
  case '{' => Punct(TokLeftBrace)
  case '}' => Punct(TokRightBrace)
  case ',' => Punct(TokComma)
  case '.' => Punct(TokDot)
  case ':' => Punct(TokColon)
  case '=' => Punct(TokAssign)
  case '<' => Punct(TokLess)
  case '>' => Punct(TokGreat)
  case '+' => Punct(TokPlus)
  case '-' => Punct(TokMinus)
  case '*' => Punct(TokStar)
  case '/' => Punct(TokSlash)
  case '%' => Punct(TokPercent)
  case '@' => Punct(TokAt)
  case '!' => Punct(TokBang)
  case '|' => Punct(TokBar)
  case _ => NotPunct
