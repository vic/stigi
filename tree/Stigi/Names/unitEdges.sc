// prompt: add the edges a parsed unit owes to the units it extends: a rule unit adds an edge from its head relation to itself and a given unit adds one from its trait to itself.
def Stigi.Names.unitEdges {Stigi.Mut} (edges: Stigi.Names.Edges, image: Stigi.Names.Image, members: Stigi.Names.Members, tables: Stigi.Syntax.Tables, from: U64, root: U64) <below(from, Stigi.Limit.maxUnits), below(root, Stigi.Limit.maxUnitNodes)>: Stigi.Names.WalkOutcome =
  Stigi.Syntax.readSlot(tables, root) match
    case MalformedTable(_) => WalkFailed(WalkFaulted(ReasonTable))
    case Fetched(node) =>
      node match
        case UnitRoot(_, _, _, decl) => Stigi.Names.declEdges(edges, image, members, tables, from, decl)
        case Absent(_) | Name(_, _) | TypeRef(_, _, _, _, _) | FactAtom(_, _, _, _, _) | FactCompare(_, _, _, _, _, _) | FactArith(_, _, _, _, _, _, _) | FactDeny(_, _) | FactGroup(_, _) | Param(_, _, _) | CapParam(_, _, _) | CapGroup(_, _) | PatName(_, _) | PatLiteral(_, _) | PatCtor(_, _, _) | PatTuple(_, _) | PatOr(_, _) | PatRange(_, _, _) | Literal(_, _, _) | Ref(_, _) | Call(_, _, _, _, _, _) | Binary(_, _, _, _) | Unary(_, _, _) | IsTest(_, _, _) | IfElse(_, _, _, _) | WhileLoop(_, _, _) | MatchOn(_, _, _) | Arm(_, _, _, _) | ValStmt(_, _, _, _, _) | VarStmt(_, _, _, _, _) | AssignStmt(_, _, _) | IndexRead(_, _, _) | IndexWrite(_, _, _, _) | HandleStmt(_, _, _, _, _, _, _, _) | AssertStmt(_, _, _) | DenyStmt(_, _) | Block(_, _) | LocalDecl(_, _) | DefHead(_, _, _, _, _, _, _, _) | FunctionDecl(_, _, _, _, _, _, _) | ValDecl(_, _, _, _, _, _) | EnumDecl(_, _, _, _, _) | EnumCase(_, _, _, _, _) | TypeDecl(_, _, _, _, _, _, _, _) | CapabilityDecl(_, _, _, _, _, _, _, _) | HandlerDecl(_, _, _, _, _, _, _, _, _, _) | TraitDecl(_, _, _, _, _) | ExternDef(_, _, _, _, _, _) | ExternVal(_, _, _, _, _) | RelationDecl(_, _, _, _) | AliasLine(_, _, _) | GivenDecl(_, _, _, _, _, _, _) | RuleDecl(_, _, _, _, _, _) => Walked(edges)
