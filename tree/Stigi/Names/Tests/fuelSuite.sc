// prompt: verify that a tree walk and a tree index with no lines left on a non-empty index stop with a named reason instead of succeeding.
val Stigi.Names.Tests.fuelSuite {Stigi.Test}: Stigi.Test.Result =
  val passed: Bool =
    val Allocated(tables) = Stigi.Syntax.allocate{Stigi.Region}() else
      case AllocationFailed => false
    val Filled(dirBuf) = Array.tryFill[U8]{Stigi.Region}(4, 0) else
      case FillFailed => false
    val Filled(pathBuf) = Array.tryFill[U8]{Stigi.Region}(Stigi.Limit.maxPathBytes, 0) else
      case FillFailed => false
    val Filled(indexBuf) = Array.tryFill[U8]{Stigi.Region}(Stigi.Limit.maxIndexBytes, 0) else
      case FillFailed => false
    val Filled(nameBuf) = Array.tryFill[U8]{Stigi.Region}(Stigi.Limit.maxUnitBytes, 0) else
      case FillFailed => false
    val Filled(sourceBuf) = Array.tryFill[U8]{Stigi.Region}(Stigi.Limit.maxUnitBytes, 0) else
      case FillFailed => false
    val Filled(tasks) = Array.tryFill[Stigi.Names.Task]{Stigi.Region}(Stigi.Names.maxScope, Restore(0)) else
      case FillFailed => false
    val Filled(locals) = Array.tryFill[Stigi.Names.Local]{Stigi.Region}(Stigi.Names.maxScope, Local(Text(0, 0), WithoutCapability)) else
      case FillFailed => false
    val Filled(pool) = Array.tryFill[U8]{Stigi.Region}(Stigi.Limit.maxIndexBytes, 0) else
      case FillFailed => false
    val Filled(entries) = Array.tryFill[Stigi.Names.Entry]{Stigi.Region}(Stigi.Limit.maxUnits, Entry(0, 0, DefKind, false)) else
      case FillFailed => false
    val Filled(slots) = Array.tryFill[Stigi.Names.KeySlot]{Stigi.Region}(Stigi.Names.tableSlots, Vacant) else
      case FillFailed => false
    val Filled(memberPool) = Array.tryFill[U8]{Stigi.Region}(Stigi.Limit.maxIndexBytes, 0) else
      case FillFailed => false
    val Filled(table) = Array.tryFill[Stigi.Names.Member]{Stigi.Region}(Stigi.Names.maxMembers, Member(0, CaseMember, 0, 0)) else
      case FillFailed => false
    val Filled(memberSlots) = Array.tryFill[Stigi.Names.KeySlot]{Stigi.Region}(Stigi.Names.tableSlots, Vacant) else
      case FillFailed => false
    val Filled(sources) = Array.tryFill[U64]{Stigi.Region}(Stigi.Names.maxEdges, 0) else
      case FillFailed => false
    val Filled(targets) = Array.tryFill[U64]{Stigi.Region}(Stigi.Names.maxEdges, 0) else
      case FillFailed => false
    val Filled(stamps) = Array.tryFill[U64]{Stigi.Region}(Stigi.Limit.maxUnits, 0) else
      case FillFailed => false
    val scratch: Stigi.Names.TreeScratch = TreeScratch(pathBuf, indexBuf, nameBuf, sourceBuf, tasks, locals)
    val tree: Stigi.Names.TreeRead = TreeRead(4, dirBuf, 0, 0, scratch, tables, 5)
    val image: Stigi.Names.Image = Image(pool, entries, 0, slots)
    val members: Stigi.Names.Members = Members(memberPool, 0, table, 0, memberSlots)
    val walkStops: Bool = Stigi.Names.walkTreeLines{Stigi.Region}(tree, image, members, Edges(sources, targets, 0, stamps), IndexWalk(0, 0), 0) match
      case TreeWalkStopped(_, _, LinesExhausted) => true
      case TreeWalkStopped(_, _, _) | TreeWalked(_) => false
    val indexStops: Bool = Stigi.Names.indexTreeLines{Stigi.Region}(tree, image, members, IndexWalk(0, 0), 0, 0) match
      case TreeIndexStopped(_, _, LinesExhausted) => true
      case TreeIndexStopped(_, _, _) | TreeIndexed(_, _, _) => false
    walkStops && indexStops
  Stigi.Test.expect(passed, true, "a walk and an index with no lines left on a non-empty index stop with a named reason")
