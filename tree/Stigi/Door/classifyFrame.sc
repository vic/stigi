// prompt: classify the leading command keyword of an incoming frame payload without allocation.
pub def Stigi.Door.classifyFrame(length: U64, text: Array[U8](length)) <below(length, 0x100000000)>: Stigi.Door.FrameKind =
  val firstScan: Stigi.Lex.ScanOutcome = Stigi.Lex.nextToken(length, text, 0)
  firstScan match
    case ScanError(_, _) => FrameUnknown
    case ScanToken(_, startOffset, endOffset) =>
      if startOffset <= endOffset && endOffset <= length then
        if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 5, "batch") then FrameBatch else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 5, "check") then FrameCheck else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 6, "accept") then FrameAccept else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 7, "summary") then FrameSummary else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 6, "budget") then FrameBudget else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 6, "submit") then FrameSubmit else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 4, "drop") then FrameDrop else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 4, "show") then FrameShow else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 4, "find") then FrameFind else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 4, "list") then FrameList else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 5, "query") then FrameQuery else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 4, "laws") then FrameLaws else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 5, "store") then FrameStore else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 4, "load") then FrameLoad else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 6, "export") then FrameExport else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 4, "emit") then FrameEmit else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 5, "tests") then FrameTests else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 4, "json") then FrameJson else if Stigi.Parse.sliceEquals(length, text, startOffset, endOffset, 4, "stop") then FrameStop else FrameUnknown
      else
        FrameUnknown
