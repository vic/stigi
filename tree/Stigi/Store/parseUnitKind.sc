// prompt: parse a stored tree index kind token slice into a UnitKind case.
pub def Stigi.Store.parseUnitKind(cap: U64, text: Array[U8](cap), startOffset: U64, endOffset: U64) <lessOrEqual(startOffset, endOffset), lessOrEqual(endOffset, cap), below(cap, 0x100000000)>: Stigi.Store.UnitKind =
  if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 4, "Enum") then KindEnum else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 4, "Type") then KindType else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 3, "Def") then KindDef else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 5, "Lemma") then KindLemma else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 3, "Val") then KindVal else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 10, "Capability") then KindCapability else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 7, "Handler") then KindHandler else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 6, "Extern") then KindExtern else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 8, "Relation") then KindRelation else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 4, "Rule") then KindRule else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 4, "Test") then KindTest else if Stigi.Parse.sliceEquals(cap, text, startOffset, endOffset, 7, "NegTest") then KindNegTest else KindUnknown
