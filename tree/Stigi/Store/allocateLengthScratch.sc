// prompt: allocate reusable scratch buffers for walking a tree and normalizing length terms while sharing syntax tables.
def Stigi.Store.allocateLengthScratch {region: Stigi.Region} (coreCap: U64, synTables: Stigi.Syntax.Tables) <lessOrEqual(coreCap, Stigi.Limit.maxUnitNodes)>: Stigi.Store.LengthScratchMade =
  val Filled(pathBuf) = Array.tryFill[U8]{region}(4096, 0) else
    case FillFailed => LengthScratchUnavailable
  val Filled(sourceBuf) = Array.tryFill[U8]{region}(Stigi.Limit.maxUnitBytes, 0) else
    case FillFailed => LengthScratchUnavailable
  val Filled(exprs) = Array.tryFill[Stigi.Core.Expr]{region}(coreCap, NothingExpr(0)) else
    case FillFailed => LengthScratchUnavailable
  val Filled(childLists) = Array.tryFill[U64]{region}(coreCap, 0) else
    case FillFailed => LengthScratchUnavailable
  val Filled(arms) = Array.tryFill[Stigi.Core.Arm]{region}(128, RestArm(0)) else
    case FillFailed => LengthScratchUnavailable
  val ScratchReady(elabScratch) = Stigi.Elaborate.allocateScratch{region}(Stigi.Limit.maxUnitNodes) else
    case ScratchUnavailable => LengthScratchUnavailable
  val Filled(work) = Array.tryFill[Stigi.Store.VisitWork]{region}(4096, RestoreBinders(0)) else
    case FillFailed => LengthScratchUnavailable
  val Filled(pool) = Array.tryFill[Stigi.Types.Linear.Term]{region}(1024, LinearTerm(0, WideInt(0, 0))) else
    case FillFailed => LengthScratchUnavailable
  val Filled(localStarts) = Array.tryFill[U64]{region}(256, 0) else
    case FillFailed => LengthScratchUnavailable
  val Filled(localEnds) = Array.tryFill[U64]{region}(256, 0) else
    case FillFailed => LengthScratchUnavailable
  val Filled(binders) = Array.tryFill[Stigi.Types.BinderKind]{region}(256, ImmutableBinder) else
    case FillFailed => LengthScratchUnavailable
  val Filled(globals) = Array.tryFill[Stigi.Types.BinderKind]{region}(Stigi.Limit.maxUnits, ImmutableBinder) else
    case FillFailed => LengthScratchUnavailable
  val Filled(unitForms) = Array.tryFill[Stigi.Types.Linear.Form]{region}(256, LinearForm(WideInt(0, 0), 0, 0)) else
    case FillFailed => LengthScratchUnavailable
  val Filled(unitValid) = Array.tryFill[Bool]{region}(256, false) else
    case FillFailed => LengthScratchUnavailable
  val Filled(nodeStack) = Array.tryFill[U64]{region}(64, 0) else
    case FillFailed => LengthScratchUnavailable
  val Filled(stepStack) = Array.tryFill[U64]{region}(64, 0) else
    case FillFailed => LengthScratchUnavailable
  val Filled(formStack) = Array.tryFill[Stigi.Types.Linear.Form]{region}(64, LinearForm(WideInt(0, 0), 0, 0)) else
    case FillFailed => LengthScratchUnavailable
  val coreTables: Stigi.Core.Tables = CoreTables(coreCap, exprs, 0, 0, coreCap, childLists, 0, 0, 128, arms, 0, 0)
  LengthScratchReady(LengthScratch(pathBuf, sourceBuf, synTables, coreTables, elabScratch, work, pool, localStarts, localEnds, binders, globals, unitForms, unitValid, nodeStack, stepStack, formStack))
