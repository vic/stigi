// prompt: lower the pattern of one unguarded match arm, one decision arm per or-alternative, all sharing the arm body.
def Stigi.Elaborate.lowerPattern {Stigi.Mut} (tables: Stigi.Syntax.Tables, patSyn: U64, bodyAt: U64, core: Stigi.Core.Tables, scratch: Stigi.Elaborate.Scratch) <below(patSyn, Stigi.Limit.maxUnitNodes)>: Stigi.Elaborate.CoreResult =
  val Tables(_, _, synNodes, _, _, _) = tables
  synNodes(patSyn) match
    case PatOr(_, alternatives) =>
      alternatives match
        case Span(altFirst, altEnd) => Stigi.Elaborate.lowerAlternatives(tables, alternatives, altFirst, bodyAt, core, scratch, altEnd - altFirst)
    case Absent(_) | Name(_, _) | TypeRef(_, _, _, _, _) | FactAtom(_, _, _, _, _) | FactCompare(_, _, _, _, _, _) | FactArith(_, _, _, _, _, _, _) | FactDeny(_, _) | FactGroup(_, _) | Param(_, _, _) | CapParam(_, _, _) | CapGroup(_, _) | PatName(_, _) | PatLiteral(_, _) | PatCtor(_, _, _) | PatTuple(_, _) | PatRange(_, _, _) | Literal(_, _, _) | Ref(_, _) | Call(_, _, _, _, _, _) | Binary(_, _, _, _) | Unary(_, _, _) | IsTest(_, _, _) | IfElse(_, _, _, _) | WhileLoop(_, _, _) | MatchOn(_, _, _) | Arm(_, _, _, _) | ValStmt(_, _, _, _, _) | VarStmt(_, _, _, _, _) | AssignStmt(_, _, _) | IndexRead(_, _, _) | IndexWrite(_, _, _, _) | HandleStmt(_, _, _, _, _, _, _, _) | AssertStmt(_, _, _) | DenyStmt(_, _) | Block(_, _) | LocalDecl(_, _) | DefHead(_, _, _, _, _, _, _, _) | FunctionDecl(_, _, _, _, _, _, _) | ValDecl(_, _, _, _, _, _) | EnumDecl(_, _, _, _, _) | EnumCase(_, _, _, _, _) | TypeDecl(_, _, _, _, _, _, _, _) | CapabilityDecl(_, _, _, _, _, _, _, _) | HandlerDecl(_, _, _, _, _, _, _, _, _, _) | TraitDecl(_, _, _, _, _) | GivenDecl(_, _, _, _, _, _, _) | ExternDef(_, _, _, _, _, _) | ExternVal(_, _, _, _, _) | RelationDecl(_, _, _, _) | RuleDecl(_, _, _, _, _, _) | UnitRoot(_, _, _, _) | AliasLine(_, _, _) => Stigi.Elaborate.lowerAlt(tables, patSyn, bodyAt, core, scratch)
