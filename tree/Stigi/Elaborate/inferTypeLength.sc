// prompt: infer an omitted Array of U8 length annotation from a string literal initializer.
def Stigi.Elaborate.inferTypeLength(tables: Stigi.Syntax.Tables, typeSyn: U64, initSyn: U64) <below(typeSyn, Stigi.Limit.maxUnitNodes), below(initSyn, Stigi.Limit.maxUnitNodes)>: Stigi.Elaborate.LengthInfer =
  val Tables(_, _, synNodes, synLists, _, _) = tables
  synNodes(typeSyn) match
    case TypeRef(_, Text(nameFirst, nameEnd), Span(typeFirst, typeEnd), Span(lenFirst, lenEnd), _) =>
      if Stigi.Syntax.textIs(tables, nameFirst, nameEnd, 5, "Array", 0, 6) && typeFirst + 1 == typeEnd && lenFirst + 1 == lenEnd then
        val elemSyn: Stigi.Syntax.NodeAt = synLists(typeFirst)
        val lenSyn: Stigi.Syntax.NodeAt = synLists(lenFirst)
        synNodes(elemSyn) match
          case TypeRef(_, Text(elemFirst, elemEnd), Span(elemTypesFirst, elemTypesEnd), Span(elemLenFirst, elemLenEnd), _) =>
            if Stigi.Syntax.textIs(tables, elemFirst, elemEnd, 2, "U8", 0, 3) && elemTypesFirst == elemTypesEnd && elemLenFirst == elemLenEnd then
              Stigi.Elaborate.decodeInferredString(tables, lenSyn, initSyn)
            else LengthExplicit
          case Absent(_) | Name(_, _) | FactAtom(_, _, _, _, _) | FactCompare(_, _, _, _, _, _) | FactArith(_, _, _, _, _, _, _) | FactDeny(_, _) | FactGroup(_, _) | Param(_, _, _) | CapParam(_, _, _) | CapGroup(_, _) | PatName(_, _) | PatLiteral(_, _) | PatCtor(_, _, _) | PatTuple(_, _) | PatOr(_, _) | PatRange(_, _, _) | Literal(_, _, _) | Ref(_, _) | Call(_, _, _, _, _, _) | Binary(_, _, _, _) | Unary(_, _, _) | IsTest(_, _, _) | IfElse(_, _, _, _) | WhileLoop(_, _, _) | MatchOn(_, _, _) | Arm(_, _, _, _) | ValStmt(_, _, _, _, _) | VarStmt(_, _, _, _, _) | AssignStmt(_, _, _) | IndexRead(_, _, _) | IndexWrite(_, _, _, _) | HandleStmt(_, _, _, _, _, _, _, _) | AssertStmt(_, _, _) | DenyStmt(_, _) | Block(_, _) | LocalDecl(_, _) | DefHead(_, _, _, _, _, _, _, _) | ValDecl(_, _, _, _, _, _) | EnumDecl(_, _, _, _, _) | EnumCase(_, _, _, _, _) | TypeDecl(_, _, _, _, _, _, _, _) | CapabilityDecl(_, _, _, _, _, _, _, _) | HandlerDecl(_, _, _, _, _, _, _, _, _, _) | TraitDecl(_, _, _, _, _) | GivenDecl(_, _, _, _, _, _, _) | ExternDef(_, _, _, _, _, _) | ExternVal(_, _, _, _, _) | RelationDecl(_, _, _, _) | RuleDecl(_, _, _, _, _, _) | AliasLine(_, _, _) | FunctionDecl(_, _, _, _, _, _, _) | UnitRoot(_, _, _, _) => LengthExplicit
      else LengthExplicit
    case Absent(_) | Name(_, _) | FactAtom(_, _, _, _, _) | FactCompare(_, _, _, _, _, _) | FactArith(_, _, _, _, _, _, _) | FactDeny(_, _) | FactGroup(_, _) | Param(_, _, _) | CapParam(_, _, _) | CapGroup(_, _) | PatName(_, _) | PatLiteral(_, _) | PatCtor(_, _, _) | PatTuple(_, _) | PatOr(_, _) | PatRange(_, _, _) | Literal(_, _, _) | Ref(_, _) | Call(_, _, _, _, _, _) | Binary(_, _, _, _) | Unary(_, _, _) | IsTest(_, _, _) | IfElse(_, _, _, _) | WhileLoop(_, _, _) | MatchOn(_, _, _) | Arm(_, _, _, _) | ValStmt(_, _, _, _, _) | VarStmt(_, _, _, _, _) | AssignStmt(_, _, _) | IndexRead(_, _, _) | IndexWrite(_, _, _, _) | HandleStmt(_, _, _, _, _, _, _, _) | AssertStmt(_, _, _) | DenyStmt(_, _) | Block(_, _) | LocalDecl(_, _) | DefHead(_, _, _, _, _, _, _, _) | ValDecl(_, _, _, _, _, _) | EnumDecl(_, _, _, _, _) | EnumCase(_, _, _, _, _) | TypeDecl(_, _, _, _, _, _, _, _) | CapabilityDecl(_, _, _, _, _, _, _, _) | HandlerDecl(_, _, _, _, _, _, _, _, _, _) | TraitDecl(_, _, _, _, _) | GivenDecl(_, _, _, _, _, _, _) | ExternDef(_, _, _, _, _, _) | ExternVal(_, _, _, _, _) | RelationDecl(_, _, _, _) | RuleDecl(_, _, _, _, _, _) | AliasLine(_, _, _) | FunctionDecl(_, _, _, _, _, _, _) | UnitRoot(_, _, _, _) => LengthExplicit
